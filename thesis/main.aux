\newlabel{fig:df-outer}{{2.5}{7}{Relevance to format selection.}{figure.2.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.6}{\ignorespaces Row-wise (Gustavson) dataflow. Each non-zero $a_{ik}$ in row $i$ of $A$ selects row $k$ of $B$. The scaled rows are accumulated into row $i$ of $C$. One output row is built at a time, so the accumulator for that row could potentially be kept in cache.}}{7}{}\protected@file@percent }
