\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {6.2}{\ignorespaces This figure shows the best performing format combo for each of the studied graphs at increasing density buckets. Each bucket collects densities in a range 0.5 decade wide. Again, there is a broad trend of the best being CSR $\times $ CSR at higher density, then transitioning to CSC $\times $ CSR or CSC $\times $ COO for sparser matrices. That this fits pretty well with K makes sense since Kroneckers become increasingly sparse as K increases. }}{67}{}\protected@file@percent }
\newlabel{fig:best_for_density}{{6.2}{67}{Outer Product Tie}{figure.6.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6.3}{\ignorespaces This figure shows the best performing format combo for each of the studied graphs at increasing nnz. Here the broad transition from CSC $\times $ CSR, to the other formats is much starker. Around ~$10^3$ non-zeroes CSR $\times $ CSR stops being the best for nearly all datasets. }}{68}{}\protected@file@percent }
\newlabel{fig:best_for_nnz}{{6.3}{68}{Outer Product Tie}{figure.6.3}{}}
